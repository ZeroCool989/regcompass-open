// Prisma schema — local-first SQLite.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Enum-like columns are plain strings (SQLite has no native enums); the
// allowed values are documented inline and enforced in TypeScript.

model UserAiCredential {
  id                  String    @id @default(cuid())
  userId              String
  provider            String // "ANTHROPIC" | "OPENAI" | "GOOGLE"
  encryptedApiKey     String
  keyFingerprint      String
  preferredModel      String?
  enabled             Boolean   @default(true)
  lastValidatedAt     DateTime?
  lastValidationError String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId, enabled])
}

/// Subscription connection (loopback OAuth). Tokens are AES-256-GCM encrypted
/// at rest and never leave the machine.
model UserClaudeOAuth {
  id                    String    @id @default(cuid())
  userId                String    @unique
  encryptedAccessToken  String
  encryptedRefreshToken String?
  tokenType             String    @default("Bearer")
  scope                 String?
  expiresAt             DateTime?
  connectedAt           DateTime  @default(now())
  lastRefreshAt         DateTime?
  lastError             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  username     String? @unique
  passwordHash String
  status       String  @default("PENDING") // "PENDING" | "APPROVED" | "BLOCKED"
  role         String  @default("USER") // "USER" | "ADMIN"
  createdAt    DateTime  @default(now())
  approvedAt   DateTime?
  emailVerifiedAt DateTime?
  /// Preferred AEGIS TTS voice. Provider-agnostic token. Null = default.
  voiceId      String?
  /// Voice-experience preferences (VoicePrefs in lib/aegis/voices.ts).
  voicePrefs   Json?
  /// Preferred AI provider for AEGIS: "ANTHROPIC" | "OPENAI" | "GOOGLE".
  /// Legacy BYOK-key preference (which stored key backs the Anthropic runtime).
  preferredAiProvider String?
  /// Selected Aegis provider (three-card model): "chatgpt-codex" | "anthropic-api" | "gemini-api".
  /// Null = not configured yet (first-use prompt). Source of truth for runtime provider selection.
  aegisProvider String?

  soulEntries   SoulEntry[]
  soulProposals SoulProposal[]
  soulAudits    SoulAudit[]
  aiCredentials UserAiCredential[]
  claudeOAuth   UserClaudeOAuth?

  @@index([status])
}

// ── Personalization (soul.md) ────────────────────────────────────────────────
// STYLE-ONLY preferences that shape how AEGIS communicates. Never business,
// regulatory, RAG, or customer data (content firewall in lib/aegis/soul.ts).

/// An APPROVED preference. Only ACTIVE entries are injected into AEGIS.
model SoulEntry {
  id              String   @id @default(uuid())
  userId          String
  section         String
  content         String
  signalCount     Int      @default(1)
  status          String   @default("ACTIVE") // "ACTIVE" | "ARCHIVED"
  lastConfirmedAt DateTime @default(now())
  usedCount       Int      @default(0)
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, section])
  @@index([userId, status])
}

/// An AI-proposed preference awaiting the user's accept/edit/reject.
model SoulProposal {
  id        String    @id @default(uuid())
  userId    String
  section   String
  content   String
  reason    String
  evidence  Json?
  status    String    @default("PENDING") // "PENDING" | "ACCEPTED" | "EDITED" | "REJECTED"
  createdAt DateTime  @default(now())
  decidedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

/// Immutable audit of every personalization decision.
model SoulAudit {
  id        String   @id @default(uuid())
  userId    String
  action    String
  section   String
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Uploaded documents (gap-analysis policies, Excel templates, filled outputs).
model AegisDocument {
  id          String   @id @default(uuid())
  sessionId   String
  filename    String
  type        String // "policy" | "template"
  textContent String
  excelData   Json?
  excelBuffer Bytes?
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  originalLanguage String?
  isTranslation    Boolean @default(false)
  translatedFromId String?
  targetLanguage   String?
  qualityWarnings  Json?

  @@index([sessionId])
  @@index([expiresAt])
}

// Persistent multi-turn AEGIS conversations.
model AegisConversation {
  id         String   @id @default(uuid())
  sessionId  String
  userId     String?
  mode       String
  language   String   @default("de")
  title      String?
  createdAt  DateTime @default(now())
  lastTurnAt DateTime @default(now())
  expiresAt  DateTime

  digest           Json?
  digestThroughSeq Int?
  digestAt         DateTime?

  messages AegisMessage[]

  @@index([sessionId, lastTurnAt])
  @@index([userId, lastTurnAt])
  @@index([expiresAt])
}

model AegisMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   AegisConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  seq            Int
  role           String // "user" | "assistant"
  content        String
  /// JSON-encoded string[] of cited requirement ids.
  citedIds       String            @default("[]")
  status         String            @default("complete") // "complete" | "failed"
  exitReason     String?
  model          String?
  mode           String?
  toolCalls      Json?
  traceId        String?
  createdAt      DateTime          @default(now())

  @@unique([conversationId, seq])
  @@index([conversationId, seq])
}

model AegisUsageLog {
  id             String @id @default(cuid())
  traceId        String
  conversationId String

  mode        String
  model       String
  servedModel String?
  language    String @default("de")

  inputTokens         Int
  outputTokens        Int
  cachedTokens        Int @default(0)
  cacheCreationTokens Int @default(0)

  /// Provider that served the run: "anthropic" | "gemini" | "chatgpt-codex".
  /// Defaults to "anthropic" so existing rows (all Anthropic) migrate unchanged.
  provider       String @default("anthropic")
  /// Cost attribution: "priced" | "subscription_unpriced" | "pricing_unknown".
  priceStatus    String @default("priced")
  /// Monetary cost in USD cents. NULL when unpriced (subscription/unknown) — a
  /// subscription or unknown-rate run must not record a fabricated dollar figure.
  costCents      Float?
  pricingVersion String @default("legacy")

  exitReason String @default("unknown")

  latencyMs  Int
  iterations Int @default(1)
  toolCalls  Int @default(0)

  verifyPassed  Boolean
  citationCount Int     @default(0)
  /// JSON-encoded string[] of triggered guardrail tokens.
  guardrailsTriggered String @default("[]")

  kbVersion String

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([mode])
  @@index([model])
  @@index([conversationId])
}

// ── Sectioned generation (AEGIS jobs) ────────────────────────────────────────

model AegisJob {
  id             String   @id @default(cuid())
  conversationId String
  status         String // 'planning' | 'running' | 'paused' | 'done' | 'failed'
  /// The runtime provider FROZEN at job creation (the three-card selection value:
  /// "anthropic-api" | "gemini-api" | "chatgpt-codex"). A paused+resumed job is the
  /// same run, so resume reads THIS — never re-reading User.aegisProvider — and a
  /// later preference change affects only new jobs. Nullable ONLY for pre-migration
  /// legacy rows (backfilled to "anthropic-api"); new jobs always set it, and a
  /// null on resume fails closed. No credential/token is ever stored here.
  provider       String?
  planJson       Json
  vocabJson      Json
  cursor         Int      @default(0)
  resumeCount    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  expiresAt      DateTime

  sections AegisJobSection[]

  @@index([conversationId])
  @@index([expiresAt])
}

model AegisJobSection {
  id            String   @id @default(cuid())
  jobId         String
  index         Int
  title         String
  scopeJson     Json
  status        String // 'pending' | 'writing' | 'revising' | 'done' | 'degraded'
  contentMd     String?
  digestJson    Json?
  citationsJson Json?
  verifyJson    Json?
  firstPassOk   Boolean?
  job           AegisJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, index])
}

// ── Regulatory radar ─────────────────────────────────────────────────────────

/// Trusted official sources the radar draws from.
model RegulatorySource {
  id           String   @id @default(uuid())
  name         String   @unique
  url          String
  jurisdiction String // "EU" | "DE" | "CH" | "INTL"
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

/// Public news-feed item — always grounded in a real source URL.
model RegulatoryNewsItem {
  id           String    @id @default(uuid())
  title        String
  summary      String
  relevance    String
  sourceName   String
  sourceUrl    String
  publishedAt  DateTime?
  jurisdiction String // "EU" | "DE" | "CH" | "INTL"
  /// JSON-encoded string[] of tags.
  tags         String    @default("[]")
  dedupeKey    String    @unique
  createdAt    DateTime  @default(now())

  @@index([jurisdiction])
  @@index([createdAt])
}

/// Internal-only proposal to add/change a KB requirement.
model RegulatoryKbSuggestion {
  id                          String    @id @default(uuid())
  sourceName                  String
  sourceUrl                   String
  regulation                  String
  proposedRequirementId       String?
  proposedRequirementText     String
  relevanceForFinancialSector String
  bindingLevel                String
  rationale                   String
  status                      String    @default("PROPOSED") // "PROPOSED" | "ACCEPTED" | "REJECTED"
  dedupeKey                   String    @unique
  reviewedBy                  String?
  reviewedAt                  DateTime?
  createdAt                   DateTime  @default(now())

  @@index([status])
  @@index([createdAt])
}

/// Run log for each radar execution.
model RegulatoryRunLog {
  id                 String    @id @default(uuid())
  startedAt          DateTime  @default(now())
  finishedAt         DateTime?
  newsFound          Int       @default(0)
  suggestionsCreated Int       @default(0)
  status             String    @default("OK") // "OK" | "EMPTY" | "ERROR"
  error              String?

  @@index([startedAt])
}

/// A regulation document fetched + converted when a radar suggestion is accepted.
model RegulatoryDocument {
  id           String    @id @default(uuid())
  suggestionId String?
  sourceName   String
  sourceUrl    String
  documentUrl  String?
  regulation   String
  title        String
  jurisdiction String // "EU" | "DE" | "CH" | "INTL"
  contentType  String?
  rawText      String?
  markdown     String?
  byteSize     Int       @default(0)
  status       String    @default("INGESTING") // "INGESTING" | "INGESTED" | "FAILED" | "NEEDS_INPUT"
  error        String?
  dedupeKey    String    @unique
  fetchedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  originalLanguage    String?
  isTranslation       Boolean   @default(false)
  originalDocumentId  String?
  targetLanguage      String?
  translationProvider String?
  translatedAt        DateTime?
  translatedBy        String?
  translationStatus   String?
  qualityWarnings     Json?

  @@unique([originalDocumentId, targetLanguage])
  @@index([status])
  @@index([regulation])
  @@index([isTranslation])
}
