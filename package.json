{
  "name": "regcompass",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "validate:kb": "tsx scripts/validate-kb.ts",
    "check:docs": "tsx scripts/check-doc-links.ts",
    "kb:manifest": "tsx scripts/generate-kb-manifest.ts",
    "news:refresh": "tsx --env-file=.env scripts/refresh-news.ts",
    "postinstall": "prisma generate",
    "setup": "prisma db push && tsx --env-file=.env scripts/setup-local.ts",
    "serve": "node bin/regcompass-open"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.0",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "better-sqlite3": "^12.11.1",
    "deepl-node": "^1.27.0",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "mammoth": "^1.12.0",
    "next": "16.2.4",
    "node-html-markdown": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.20.0",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.14.0",
    "three": "^0.184.0",
    "unpdf": "^1.6.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.0",
    "@vitest/ui": "^4.1.5",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "regcompass-open": "bin/regcompass-open"
  }
}
