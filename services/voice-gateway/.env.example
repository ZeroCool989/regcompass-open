# RegCompass voice-gateway — Hetzner real-time audio loop (NOT Vercel).
# Separate deployable from the Next app; copy to .env and fill in.

# ── AEGIS bridge ────────────────────────────────────────────────────────────
# Voice routes THROUGH the AEGIS brain (/api/aegis), inheriting intent routing,
# KB grounding, the verify step, citations, and conversation memory.
AEGIS_BRIDGE_URL="https://regcompass-ebon.vercel.app"
# Service-to-service auth to /api/aegis (validated by AEGIS). See proposal —
# a signed service token (Bearer), NOT the browser rc_session cookie.
AEGIS_SERVICE_TOKEN="change-me-service-token"

# NOTE: there is intentionally NO ANTHROPIC_API_KEY here. The gateway never calls
# Claude directly — AEGIS owns the key. The gateway only reaches /api/aegis with
# the service token above. Keeping the key out of this box shrinks its blast
# radius and keeps the model boundary in one place.

# ── STT: self-hosted faster-whisper (in-infra; German) ──────────────────────
WHISPER_URL="http://127.0.0.1:9000"
WHISPER_MODEL="large-v3"
WHISPER_LANGUAGE="de"

# ── TTS seam (the swappable, audited boundary) ──────────────────────────────
# "cartesia" (cloud, third-party — demo only) | "kokoro" (self-hosted, in-infra)
TTS_PROVIDER="cartesia"
# Cartesia sonic-3, German voice (third-party — refused when CLIENT_DATA_MODE=true).
CARTESIA_API_KEY="change-me-cartesia-key"
CARTESIA_MODEL="sonic-3"
CARTESIA_VOICE_ID="change-me-de-voice-id"
# Kokoro self-hosted (in-infra) — the target before client data.
KOKORO_URL="http://127.0.0.1:8880"
KOKORO_VOICE="de"

# ── Residency gate ──────────────────────────────────────────────────────────
# When true, the gateway REFUSES to boot with a third-party TTS provider.
# Keep false for the internal demo; set true before any real client data.
CLIENT_DATA_MODE="false"

# ── Gateway WSS auth (browser → gateway) ────────────────────────────────────
# Shared secret authenticating browser audio-socket clients to this gateway.
GATEWAY_WSS_SECRET="change-me-wss-secret"

PORT="8787"
