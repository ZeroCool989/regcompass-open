# Local database (SQLite file — created by `pnpm setup`)
DATABASE_URL="file:./local.db"

# ─── The brain (which model powers AEGIS) ───
# Anthropic is the default. Set AEGIS_BRAIN to run AEGIS on another backend:
#   (unset) | anthropic  → Claude via ANTHROPIC_API_KEY
#   openai              → OpenAI via OPENAI_API_KEY (+ optional OPENAI_MODEL)
#   gemini              → Google Gemini via GOOGLE_API_KEY
#   ollama              → local Ollama (OLLAMA_BASE_URL, OLLAMA_MODEL)
#   custom              → any OpenAI-compatible endpoint (self-hosted / gateway)
#   cli                 → a locally-installed agent CLI (AEGIS_CLI_COMMAND)
# AEGIS_BRAIN="custom"

# Anthropic (default brain)
ANTHROPIC_API_KEY="sk-ant-..."

# OpenAI (AEGIS_BRAIN=openai)
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4.1"

# Google Gemini (AEGIS_BRAIN=gemini)
# GOOGLE_API_KEY="..."

# Local Ollama (AEGIS_BRAIN=ollama)
# OLLAMA_BASE_URL="http://localhost:11434/v1"
# OLLAMA_MODEL="llama3.3"

# Self-hosted / custom OpenAI-compatible endpoint (AEGIS_BRAIN=custom)
# OPENAI_COMPAT_BASE_URL="https://your-host.example.com/v1"
# OPENAI_COMPAT_API_KEY="..."
# OPENAI_COMPAT_MODEL="your-model-id"
# OPENAI_COMPAT_LABEL="My model"

# Local agent CLI as the brain (AEGIS_BRAIN=cli) — uses a CLI you're already
# signed in to, no API key needed. Text answers only (not the KB tool loop).
# AEGIS_CLI_COMMAND="claude"          # claude | codex | gemini (must be on PATH)
# AEGIS_CLI_ARGS="--model sonnet"     # optional extra argv, passed verbatim
# AEGIS_CLI_TIMEOUT_MS="180000"       # optional; default 180s

# Encrypts user-supplied AI provider API keys (BYOK) at rest.
# Required in production/preview before /account/providers can save credentials.
# Generate with: openssl rand -hex 32
AEGIS_BYOK_ENCRYPTION_KEY="change-me-64-hex-chars"

# DeepL (powers AEGIS Translate — document translation into DE/EN). Optional:
# without it the translation features degrade gracefully (the "Übersetzen"
# action is disabled and the translate endpoints return 503). Free-tier keys
# end with ":fx" (the deepl-node SDK auto-selects the Free vs Pro endpoint).
DEEPL_API_KEY="..."

# Signs the anonymous session cookie AND the auth (login) cookie. Any long
# random string, e.g. `openssl rand -hex 32`. Changing it logs everyone out.
SESSION_SECRET="change-me-32-random-bytes"

# Auth mode. Default (unset or "local"): NO login — the app runs as one
# implicit local user; AEGIS only needs a configured model brain. Set to
# "multi" for a shared instance with accounts: people register at /register,
# the FIRST account on a fresh database automatically becomes the approved
# admin, later accounts start PENDING until an admin approves them at
# /admin/users. Existing local-mode data is handed to the first admin.
# AUTH_MODE="multi"

# multi mode only — optional registration restriction. Empty (default) =
# anyone who can reach the instance may register. Set comma-separated emails
# to restrict registration to exactly those addresses.
AUTH_ALLOWLIST=

# multi mode only — optional comma-separated admin emails: accounts
# registering with one of these are granted the ADMIN role + auto-approved
# (in addition to the first account).
# ADMIN_EMAILS="you@example.com"

# Protects /api/cron/retention (Vercel sends it as a Bearer token).
# Required in production; optional locally.
CRON_SECRET="change-me-cron-secret"

# ─── AEGIS time-budget gating ───
# Skip a max_tokens continuation (finalise with the explicit note instead)
# when less wall-clock than this remains — a full continuation pass is another
# model call (~142s for 8192 tokens on Sonnet) and would blow the stream
# deadline mid-generation, costing the user the streamed draft.
AEGIS_CONTINUATION_TIME_FLOOR_MS=75000

# ─── AEGIS sectioned generation ───
# Master switch (Station 2). OFF by default until PR 3 ships the client
# progress UI — with 0, live behaviour is byte-identical to single-pass.
AEGIS_SECTIONED_ENABLED=0
# Triage: a prompt with >= this many numbered sections is generated section-wise.
AEGIS_SECTIONED_MIN_SECTIONS=5
# Triage: estimated input tokens above which a prompt is generated section-wise.
AEGIS_SECTIONED_INPUT_TOKENS=2000
# Output ceiling per section (also caps plan estTokens).
AEGIS_SECTION_MAX_TOKENS=4096
# Tool-free repair passes per section before it is marked 'degraded'.
AEGIS_SECTION_REPAIR_MAX=2
# Trigram-overlap threshold against finished-section digests → duplicate repair.
AEGIS_DUP_TRIGRAM_THRESHOLD=0.35
# Optional glue pass (intro/transitions/executive summary; never edits sections).
AEGIS_GLUE_PASS_ENABLED=false
# Pause the job (clean, resumable) when less wall-clock than this remains —
# sized so a grounded section incl. tool loop + digest never starts half.
AEGIS_RESUME_TIME_FLOOR_MS=90000
# Hard cap on resume invocations per job; beyond it the job fails (audited).
AEGIS_JOB_MAX_RESUMES=12
# Per-session resume-request bucket (own limiter, never the 30/h IP bucket).
AEGIS_RESUME_RATE_LIMIT=30
# Job retention: AegisJob rows expire after this many hours (retention cron).
AEGIS_JOB_TTL_HOURS=168
# Input cap (chars) for the per-section Haiku digest call.
AEGIS_SECTION_DIGEST_MAX_CHARS=24000
# Server bound for one chat message (chars). The client textarea enforces the
# 32000 default via maxLength — raise both together (lib/aegis/limits.ts).
AEGIS_MESSAGE_MAX_CHARS=32000

# App
NEXT_PUBLIC_APP_NAME="RegCompass"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── D10 "Sign in with Claude" (subscription connect) ─────────────────────────
# Approval-gated by Anthropic: these values are issued when RegCompass is
# registered as an official Claude app (docs/aegis/SIGN_IN_WITH_CLAUDE.md).
# The feature shows "Setup erforderlich" in the UI until CLIENT_ID and
# TOKEN_URL are set. Do NOT guess endpoints.
# ANTHROPIC_OAUTH_CLIENT_ID=
# ANTHROPIC_OAUTH_CLIENT_SECRET=
# ANTHROPIC_OAUTH_AUTHORIZE_URL=https://claude.ai/oauth/authorize
# ANTHROPIC_OAUTH_TOKEN_URL=
# ANTHROPIC_OAUTH_SCOPES=

# ChatGPT (OpenAI) subscription — public authorize/token defaults; id is enough.
# See docs/OAUTH_SETUP.md.
# OPENAI_OAUTH_CLIENT_ID=
# OPENAI_OAUTH_CLIENT_SECRET=

# Gemini (Google) subscription — public authorize/token defaults; needs id + secret.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Only needed if the app is not served at http://localhost:3000
# APP_BASE_URL=http://localhost:3000
